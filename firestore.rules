rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /contents/{contentId} {
      allow read: if resource.data.published == true || (request.auth != null && request.auth.uid == "FdD7joDNPbg2kRrvueQCxotIDl03");
      allow create, update, delete: if request.auth != null && request.auth.uid == "FdD7joDNPbg2kRrvueQCxotIDl03";
    }
    match /settings/{settingId} {
      allow read: if settingId == "ads";
      allow write: if request.auth != null && request.auth.uid == "FdD7joDNPbg2kRrvueQCxotIDl03";
    }
  }
}
